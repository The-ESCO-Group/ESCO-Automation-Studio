{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESCO Automation Studio",
  "version": "0.0.1",
  "identifier": "com.scintilla.escogroup.automationstudio",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @esco/web dev -- --host 127.0.0.1",
    "beforeBuildCommand": "corepack pnpm --filter @esco/web build",
    "devUrl": "http://127.0.0.1:5173/?desktop-startup=1",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ESCO Automation Studio",
        "url": "index.html?desktop-startup=1",
        "width": 758,
        "height": 558,
        "minWidth": 758,
        "minHeight": 558,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "publisher": "Scintilla ESCO Group",
    "shortDescription": "PLC Engineering IDE",
    "longDescription": "ESCO Automation Studio is an offline-first PLC engineering IDE and simulation workstation."
  }
}
