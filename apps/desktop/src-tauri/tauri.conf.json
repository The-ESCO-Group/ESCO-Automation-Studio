{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESCO Automation Studio",
  "version": "0.0.1",
  "identifier": "com.scintilla.escogroup.automationstudio",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @esco/web exec vite --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "corepack pnpm --filter @esco/web build",
    "devUrl": "http://127.0.0.1:5173/?desktop-startup=1",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ESCO Automation Studio",
        "url": "index.html?desktop-startup=1",
        "width": 760,
        "height": 560,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": false,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://localhost:4000 http://127.0.0.1:4000 https://api.anthropic.com https://api.openai.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "publisher": "Scintilla ESCO Group",
    "shortDescription": "PLC Engineering IDE",
    "longDescription": "ESCO Automation Studio is an offline-first PLC engineering IDE and simulation workstation."
  }
}
